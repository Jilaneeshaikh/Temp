from sklearn.metrics import (
    classification_report, confusion_matrix, 
    mean_absolute_error, r2_score
)

class Evaluator:
    @staticmethod
    def report_classification(y_true, y_pred):
        print("--- Classification Report ---")
        print(classification_report(y_true, y_pred))
        # Visualizing the Confusion Matrix
        cm = confusion_matrix(y_true, y_pred)
        sns.heatmap(cm, annot=True, fmt='d', cmap='Blues')
        plt.show()

    @staticmethod
    def report_regression(y_true, y_pred):
        print("--- Regression Report ---")
        print(f"R2 Score: {r2_score(y_true, y_pred):.4f}")
        print(f"MAE: {mean_absolute_error(y_true, y_pred):.4f}")
        # Residual Plot: If this looks like a random cloud, the model is good!
        residuals = y_true - y_pred
        plt.scatter(y_pred, residuals)
        plt.axhline(0, color='red', linestyle='--')
        plt.show()

Stage 9: Diagnostics (The Health Check)

from sklearn.model_selection import learning_curve

def plot_learning_curve(pipeline, X, y):
    train_sizes, train_scores, test_scores = learning_curve(
        pipeline, X, y, cv=5, scoring='r2', n_jobs=-1
    )
    
    # Calculate means
    train_mean = np.mean(train_scores, axis=1)
    test_mean = np.mean(test_scores, axis=1)
    
    # Plotting
    plt.plot(train_sizes, train_mean, label='Training Score')
    plt.plot(train_sizes, test_mean, label='Validation Score')
    plt.xlabel('Training Data Size')
    plt.ylabel('Score')
    plt.legend()
    plt.title('Learning Curve: Are we Overfitting?')
    plt.show()

