# The "Kaggle Secret" Feature Engineering Layer
def engineer_features(df):
    # Creating a new feature by combining two existing ones
    df['Income_to_Debt_Ratio'] = df['Salary'] / (df['Total_Debt'] + 1)
    
    # Extracting high-value time features
    df['Is_Weekend'] = df['Date'].dt.dayofweek >= 5
    
    # Target Encoding (Very popular on Kaggle for categorical data)
    # E.g., Replacing 'City' with the average historical sales of that 'City'
    city_means = df.groupby('City')['Sales'].transform('mean')
    df['City_Historical_Sales'] = city_means
    
    return df
