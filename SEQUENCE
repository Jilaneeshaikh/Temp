Below is a complete starter script that:

✅ Finds latest date folder automatically

✅ Reads SPA_Today.xlsx

✅ Creates Packaging_Report.xlsx

✅ Copies Material column

✅ Creates your exact layout

✅ Adds XLOOKUP formulas in H and I

❌ Does NOT insert images yet (we'll add that later)

import pandas as pd
from pathlib import Path
from datetime import datetime
from openpyxl import Workbook
from openpyxl.styles import Font

# =====================================================
# FIND LATEST RESULTS FOLDER
# =====================================================

BASE_DIR = Path.cwd()
RESULTS_DIR = BASE_DIR / "Results"

date_folders = [f for f in RESULTS_DIR.iterdir() if f.is_dir()]

if not date_folders:
    raise Exception("No Results folders found")

DATE_FOLDER = max(
    date_folders,
    key=lambda x: x.stat().st_mtime
)

print(f"[INFO] Using Folder: {DATE_FOLDER}")

# =====================================================
# FOLDERS
# =====================================================

INPUT_DIR = DATE_FOLDER / "Input"
OUTPUT_DIR = DATE_FOLDER / "Output sheet"

OUTPUT_DIR.mkdir(exist_ok=True)

# =====================================================
# FIND SPA FILE
# =====================================================

spa_file = None

for f in INPUT_DIR.glob("*.xlsx"):

    if "spa" in f.name.lower():
        spa_file = f
        break

if not spa_file:
    raise Exception("SPA file not found")

print(f"[INFO] SPA File: {spa_file.name}")

# =====================================================
# READ SPA FILE
# =====================================================

df = pd.read_excel(spa_file)

if "Material" not in df.columns:
    raise Exception("Material column not found")

materials = (
    df["Material"]
    .dropna()
    .astype(str)
    .str.strip()
    .unique()
)

print(f"[INFO] Materials Found: {len(materials)}")

# =====================================================
# CREATE WORKBOOK
# =====================================================

wb = Workbook()
ws = wb.active

ws.title = "Packaging Report"

# =====================================================
# HEADERS
# =====================================================

headers = [
    "Material",      # A
    "Part Image",    # B
    "",              # C
    "",              # D
    "",              # E
    "",              # F
    "",              # G
    "Container",     # H
    "Qty",           # I
    "",              # J
    "",              # K
    "Packaging ISO", # L
    "Packaging TOP"  # M
]

for col_num, header in enumerate(headers, start=1):

    cell = ws.cell(row=1, column=col_num)

    cell.value = header
    cell.font = Font(bold=True)

# =====================================================
# COLUMN WIDTHS
# =====================================================

ws.column_dimensions["A"].width = 20
ws.column_dimensions["B"].width = 25

ws.column_dimensions["H"].width = 20
ws.column_dimensions["I"].width = 15

ws.column_dimensions["L"].width = 25
ws.column_dimensions["M"].width = 25

# =====================================================
# MATERIAL DATA
# =====================================================

row = 2

for material in materials:

    ws[f"A{row}"] = material

    # Container Formula
    ws[f"H{row}"] = (
        f'=XLOOKUP(A{row},'
        f'Container!A:A,'
        f'Container!B:B,"")'
    )

    # Qty Formula
    ws[f"I{row}"] = (
        f'=XLOOKUP(A{row},'
        f'Container!A:A,'
        f'Container!C:C,"")'
    )

    row += 1

# =====================================================
# SAVE
# =====================================================

output_file = OUTPUT_DIR / "Packaging_Report.xlsx"

wb.save(output_file)

print("=" * 60)
print("[SUCCESS]")
print(f"Saved: {output_file}")
print("=" * 60)
