from pathlib import Path
from openpyxl import load_workbook
from openpyxl.drawing.image import Image

# =====================================================
# FIND LATEST DATE FOLDER
# =====================================================

BASE_DIR = Path.cwd()
RESULTS_DIR = BASE_DIR / "Results"

date_folders = [
    f for f in RESULTS_DIR.iterdir()
    if f.is_dir()
]

if not date_folders:
    raise Exception("No Results folder found")

DATE_FOLDER = max(
    date_folders,
    key=lambda x: x.stat().st_mtime
)

print(f"[INFO] Using Folder: {DATE_FOLDER}")

# =====================================================
# PATHS
# =====================================================

PART_IMAGE_DIR = DATE_FOLDER / "Part croped image"

PACKAGING_IMAGE_DIR = (
    DATE_FOLDER /
    "Packaging Croped Image"
)

REPORT_FILE = (
    DATE_FOLDER /
    "Output sheet" /
    "Packaging_Report.xlsx"
)

# =====================================================
# LOAD EXCEL
# =====================================================

wb = load_workbook(REPORT_FILE)

ws = wb.active

# =====================================================
# COLUMN WIDTHS
# =====================================================

ws.column_dimensions["B"].width = 25
ws.column_dimensions["L"].width = 25
ws.column_dimensions["M"].width = 25

# =====================================================
# PROCESS MATERIALS
# =====================================================

last_row = ws.max_row

print(f"[INFO] Rows Found: {last_row}")

for row in range(2, last_row + 1):

    material = ws[f"A{row}"].value

    if not material:
        continue

    material = str(material).strip()

    # =================================================
    # PART IMAGE
    # =================================================

    part_img = (
        PART_IMAGE_DIR /
        f"{material}.png"
    )

    if part_img.exists():

        try:

            img = Image(str(part_img))

            img.width = 120
            img.height = 90

            ws.add_image(
                img,
                f"B{row}"
            )

        except Exception as e:

            print(
                f"[ERROR] Part Image "
                f"{material}: {e}"
            )

    # =================================================
    # ISO IMAGE
    # =================================================

    iso_img = (
        PACKAGING_IMAGE_DIR /
        f"{material}_ISO.png"
    )

    if iso_img.exists():

        try:

            img = Image(str(iso_img))

            img.width = 120
            img.height = 90

            ws.add_image(
                img,
                f"L{row}"
            )

        except Exception as e:

            print(
                f"[ERROR] ISO Image "
                f"{material}: {e}"
            )

    # =================================================
    # TOP IMAGE
    # =================================================

    top_img = (
        PACKAGING_IMAGE_DIR /
        f"{material}_TOP.png"
    )

    if top_img.exists():

        try:

            img = Image(str(top_img))

            img.width = 120
            img.height = 90

            ws.add_image(
                img,
                f"M{row}"
            )

        except Exception as e:

            print(
                f"[ERROR] TOP Image "
                f"{material}: {e}"
            )

    # =================================================
    # ROW HEIGHT
    # =================================================

    ws.row_dimensions[row].height = 80

# =====================================================
# SAVE
# =====================================================

wb.save(REPORT_FILE)

print("=" * 60)
print("[SUCCESS]")
print("Images inserted successfully")
print(REPORT_FILE)
print("=" * 60)
