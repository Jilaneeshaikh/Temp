Stage 3: Supervised Benchmarking (The Baseline)

from sklearn.linear_model import LinearRegression
from sklearn.tree import DecisionTreeRegressor
from sklearn.ensemble import RandomForestRegressor, GradientBoostingRegressor
from sklearn.model_selection import cross_val_score

class ModelBenchmark:
    def __init__(self, pipeline):
        self.pipeline = pipeline
        self.models = {
            "Linear": LinearRegression(),
            "Tree": DecisionTreeRegressor(),
            "RF": RandomForestRegressor(),
            "GBM": GradientBoostingRegressor()
        }

    def run(self, X, y):
        leaderboard = {}
        for name, model in self.models.items():
            # Swap the model in the pipeline
            self.pipeline.set_params(model=model)
            
            # Cross-validation (The reliability check)
            scores = cross_val_score(self.pipeline, X, y, cv=5, scoring='r2')
            leaderboard[name] = scores.mean()
            print(f"{name} finished: R2 = {scores.mean():.4f}")
        return leaderboard


Stage 4: Hyperparameter Tuning (The Search)
  from sklearn.model_selection import RandomizedSearchCV

class ModelTuner:
    def __init__(self, pipeline):
        self.pipeline = pipeline

    def optimize(self, X, y, param_space):
        # We search for the best "knobs"
        search = RandomizedSearchCV(
            self.pipeline, 
            param_distributions=param_space, 
            n_iter=20, 
            cv=5, 
            scoring='r2', 
            n_jobs=-1,  # Use all computer power
            random_state=42
        )
        search.fit(X, y)
        print(f"Best Score: {search.best_score_:.4f}")
        print(f"Best Params: {search.best_params_}")
        return search.best_estimator_  


